# Joins the Lua parts listed in PARTS_FILE (relative to SOURCE_DIR) into OUTPUT, in order.
if(NOT DEFINED OUTPUT OR NOT DEFINED PARTS_FILE OR NOT DEFINED SOURCE_DIR)
    message(FATAL_ERROR "OUTPUT, PARTS_FILE and SOURCE_DIR are required")
endif()

file(STRINGS "${PARTS_FILE}" part_names)
file(WRITE "${OUTPUT}.tmp" "")
foreach(part_name IN LISTS part_names)
    if(part_name STREQUAL "")
        continue()
    endif()
    set(part "${SOURCE_DIR}/${part_name}")
    if(NOT EXISTS "${part}")
        message(FATAL_ERROR "Lua source part not found: ${part}")
    endif()
    file(READ "${part}" content)
    file(APPEND "${OUTPUT}.tmp" "${content}")
endforeach()
file(RENAME "${OUTPUT}.tmp" "${OUTPUT}")
