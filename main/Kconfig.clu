choice CLU_BOARD
    prompt "Board"
    default CLU_BOARD_GRENTON_GATE if IDF_TARGET_ESP32
    default CLU_BOARD_WAVESHARE_S3_RS485_CAN
    help
        Fixes the board's hardware: network interface, RS485 / I2C / Ethernet pins, RTC chip,
        on-board IO and setup button. Their options are hidden for a named board and always
        follow it, also when the board is changed later. "Custom" shows them all; it starts
        from the values of the previously selected board. Features (WiFi, bus protocol, device
        type, services) stay configurable on every board. Flash size, PSRAM mode and the
        console UART are ESP-IDF options: the target and the preset's sdkconfig.defaults.* set
        them.

    config CLU_BOARD_WAVESHARE_S3_RS485_CAN
        bool "Waveshare ESP32-S3-RS485-CAN"
        depends on IDF_TARGET_ESP32S3
        select CLU_RTC
        set CLU_RTC_SDA_GPIO=39
        set CLU_RTC_SCL_GPIO=38
        set CLU_RS485_UART=1 if CLU_TFBUS || CLU_MYSENSORS
        set CLU_RS485_TX_GPIO=17 if CLU_TFBUS || CLU_MYSENSORS
        set CLU_RS485_RX_GPIO=18 if CLU_TFBUS || CLU_MYSENSORS
        set CLU_RS485_DE_GPIO=21 if CLU_TFBUS || CLU_MYSENSORS
        set CLU_SETUP_BUTTON_GPIO=0 if CLU_SETUP_WINDOW_S != 0
        help
            WiFi, RS485 with DE (TX 17, RX 18, DE 21), PCF85063 RTC (SDA 39, SCL 38), setup button
            GPIO0 (BOOT). See docs/devices/waveshare-esp32-s3-rs485-can.md.

    config CLU_BOARD_GRENTON_GATE
        bool "Grenton GATE (ESP32-WROVER-B, LAN8720A)"
        depends on IDF_TARGET_ESP32
        select CLU_ETH
        set CLU_ETH_PHY_ADDR=0
        set CLU_ETH_MDC_GPIO=23
        set CLU_ETH_MDIO_GPIO=18
        set CLU_ETH_PHY_RST_GPIO=2
        set CLU_RS485_UART=1 if CLU_TFBUS || CLU_MYSENSORS
        set CLU_RS485_TX_GPIO=4 if CLU_TFBUS || CLU_MYSENSORS
        set CLU_RS485_RX_GPIO=3 if CLU_TFBUS || CLU_MYSENSORS
        set CLU_RS485_DE_GPIO=5 if CLU_TFBUS || CLU_MYSENSORS
        set CLU_SETUP_BUTTON_GPIO=34 if CLU_SETUP_WINDOW_S != 0
        help
            Ethernet: internal EMAC + LAN8720A (PHY address 0, MDC 23, MDIO 18, reset 2, external
            50 MHz clock into GPIO0). RS485 on UART1 (TX 4, RX 3, DE 5), no RTC, setup button
            GPIO34 (the reset button). See docs/devices/grenton-gate.md.

    config CLU_BOARD_KINCONY_F8
        bool "KinCony F8 (W5500)"
        depends on IDF_TARGET_ESP32S3
        select CLU_ETH
        set CLU_ETH_SPI_SCLK_GPIO=42
        set CLU_ETH_SPI_MOSI_GPIO=43
        set CLU_ETH_SPI_MISO_GPIO=44
        set CLU_ETH_SPI_CS_GPIO=41
        set CLU_ETH_SPI_INT_GPIO=2
        set CLU_ETH_SPI_RST_GPIO=1
        set CLU_RS485_UART=1 if CLU_TFBUS || CLU_MYSENSORS
        set CLU_RS485_TX_GPIO=16 if CLU_TFBUS || CLU_MYSENSORS
        set CLU_RS485_RX_GPIO=17 if CLU_TFBUS || CLU_MYSENSORS
        set CLU_RS485_DE_GPIO=-1 if CLU_TFBUS || CLU_MYSENSORS
        select CLU_RTC
        set CLU_RTC_SDA_GPIO=8
        set CLU_RTC_SCL_GPIO=18
        select CLU_LOCAL_IO if !CLU_DEVICE_GATE_HTTP
        select CLU_LOCAL_IO_OUT_ACTIVE_LOW if CLU_LOCAL_IO
        select CLU_LOCAL_IO_IN_ACTIVE_LOW if CLU_LOCAL_IO
        set CLU_LOCAL_IO_SDA_GPIO=8 if CLU_LOCAL_IO
        set CLU_LOCAL_IO_SCL_GPIO=18 if CLU_LOCAL_IO
        set CLU_LOCAL_IO_ADDR=0x24 if CLU_LOCAL_IO
        select CLU_DISPLAY
        set CLU_DISPLAY_SDA_GPIO=8
        set CLU_DISPLAY_SCL_GPIO=18
        set CLU_DISPLAY_ADDR=0x3c
        set CLU_SETUP_BUTTON_GPIO=0 if CLU_SETUP_WINDOW_S != 0
        help
            W5500 (SCLK 42, MOSI 43, MISO 44, CS 41, INT 2, RST 1), RS485 with automatic
            direction (TX 16, RX 17), DS3231 RTC, PCF8575 at 0x24 (relays P10-P17, inputs
            P00-P07) and SSD1306 OLED at 0x3c on I2C SDA 8 / SCL 18, GPIO inputs 48, 47, 21, 15, 14
            as a second module, setup button GPIO0. W5500
            uses GPIO43/44, the UART0 console pins: the console defaults to USB-Serial-JTAG.
            See docs/devices/kincony-f8.md.

    config CLU_BOARD_KINCONY_A8V3
        bool "KinCony KC868-A8v3 (W5500)"
        depends on IDF_TARGET_ESP32S3
        select CLU_ETH
        set CLU_ETH_SPI_SCLK_GPIO=1
        set CLU_ETH_SPI_MOSI_GPIO=2
        set CLU_ETH_SPI_MISO_GPIO=41
        set CLU_ETH_SPI_CS_GPIO=42
        set CLU_ETH_SPI_INT_GPIO=43
        set CLU_ETH_SPI_RST_GPIO=44
        set CLU_RS485_UART=1 if CLU_TFBUS || CLU_MYSENSORS
        set CLU_RS485_TX_GPIO=39 if CLU_TFBUS || CLU_MYSENSORS
        set CLU_RS485_RX_GPIO=38 if CLU_TFBUS || CLU_MYSENSORS
        set CLU_RS485_DE_GPIO=-1 if CLU_TFBUS || CLU_MYSENSORS
        select CLU_RTC
        set CLU_RTC_SDA_GPIO=8
        set CLU_RTC_SCL_GPIO=18
        select CLU_LOCAL_IO if !CLU_DEVICE_GATE_HTTP
        select CLU_LOCAL_IO_OUT_ACTIVE_LOW if CLU_LOCAL_IO
        select CLU_LOCAL_IO_IN_ACTIVE_LOW if CLU_LOCAL_IO
        set CLU_LOCAL_IO_SDA_GPIO=8 if CLU_LOCAL_IO
        set CLU_LOCAL_IO_SCL_GPIO=18 if CLU_LOCAL_IO
        set CLU_LOCAL_IO_ADDR=0x22 if CLU_LOCAL_IO
        set CLU_SETUP_BUTTON_GPIO=0 if CLU_SETUP_WINDOW_S != 0
        help
            W5500 (SCLK 1, MOSI 2, MISO 41, CS 42, INT 43, RST 44), RS485 with automatic
            direction (TX 39, RX 38), DS3231 RTC and PCF8575 at 0x22 (relays P00-P07, inputs
            P10-P17) on I2C SDA 8 / SCL 18, setup button GPIO0. W5500 uses GPIO43/44, the UART0
            console pins: the console defaults to USB-Serial-JTAG.
            See docs/devices/kincony-kc868-a8v3.md.

    config CLU_BOARD_CUSTOM
        bool "Custom"
        help
            Any other board: every pin, interface and chip option below is editable.
            See docs/devices/other-esp32-s3.md.
endchoice

# W5500 on GPIO43/44 (UART0 console pins): primary console on the native USB. Only a default, so
# menuconfig can still change it. Kconfig.clu is read before ESP-IDF's Kconfig (root wrapper in
# CMakeLists.txt) and the first default whose condition holds wins over ESP-IDF's UART default.
choice ESP_CONSOLE_UART
    default ESP_CONSOLE_USB_SERIAL_JTAG if CLU_BOARD_KINCONY_F8 || CLU_BOARD_KINCONY_A8V3
endchoice

config CLU_WIFI_REQUIRED
    bool
    default y if !CLU_ETH
    select CLU_WIFI

menuconfig CLU_WIFI
    bool "WiFi station"
    default n if CLU_ETH
    default y
    help
        At least one interface is always enabled: without Ethernet, WiFi is forced on
        (shown as -*-). With Ethernet on, WiFi is optional.

if CLU_WIFI

    config CLU_WIFI_SSID
        string "WiFi SSID"
        default ""

    config CLU_WIFI_PASSWORD
        string "WiFi password"
        default ""

    config CLU_WIFI_BSSID
        string "WiFi BSSID (aa:bb:cc:dd:ee:ff, empty = any AP with the SSID)"
        default ""
        help
            Connect only to this access point MAC. Useful with several APs sharing the SSID.

    config CLU_WIFI_WPA3_ONLY
        bool "Require WPA3 (refuse WPA2 access points)"
        default n
        help
            Off: joins WPA2-PSK, WPA2/WPA3 and WPA3-SAE networks (never open or WEP/WPA).
            On: joins only WPA3-SAE networks, which also rules out downgrade to WPA2.

    config CLU_WIFI_MAX_TX_POWER
        int "WiFi max TX power (0.25 dBm units, 0 = driver default)"
        range 0 84
        default 0
        help
            Lower it (e.g. 34 = 8.5 dBm) when the board sees the AP but authentication
            always times out (reason 2): some boards' antennas misbehave at full power.

endif

config CLU_NET_DIAG_INTERVAL
    int "Network diagnostics log interval (s, 0 = off)"
    range 0 3600
    default 0
    help
        Every N seconds log one line: internal heap (free / minimum ever / largest block),
        PSRAM free, interfaces up, MQTT link, and with WiFi the AP (BSSID, channel, RSSI),
        followed by the WiFi driver's buffer statistics (esp_wifi_statis_dump). For chasing
        link stalls: correlate with MQTT drops and the broker log.

menuconfig CLU_ETH
    bool "Ethernet" if CLU_BOARD_CUSTOM
    default y if IDF_TARGET_ESP32
    help
        Wired network: the ESP32's internal EMAC with an RMII PHY (Grenton GATE: LAN8720A), or
        a WIZnet W5500 on SPI (any target; KinCony F8, KC868-A8v3). With Ethernet on, WiFi becomes
        optional (both can run in parallel); with Ethernet off, WiFi is always on. Ethernet has
        the default route when both have an address.

if CLU_ETH

    choice CLU_ETH_IF
        prompt "Interface"
        default CLU_ETH_IF_EMAC if IDF_TARGET_ESP32
        default CLU_ETH_IF_W5500

        config CLU_ETH_IF_EMAC
            bool "Internal EMAC + RMII PHY (Grenton GATE)"
            depends on IDF_TARGET_ESP32
            depends on CLU_BOARD_CUSTOM || CLU_BOARD_GRENTON_GATE
            help
                Only the classic ESP32 has the EMAC.
        config CLU_ETH_IF_W5500
            bool "WIZnet W5500 on SPI (KinCony F8, KC868-A8v3)"
            depends on !CLU_BOARD_GRENTON_GATE
    endchoice

    if CLU_ETH_IF_W5500

        config CLU_ETH_SPI_SCLK_GPIO
            int "W5500 SPI SCLK GPIO" if CLU_BOARD_CUSTOM
            range 0 48
            default 42

        config CLU_ETH_SPI_MOSI_GPIO
            int "W5500 SPI MOSI GPIO" if CLU_BOARD_CUSTOM
            range 0 48
            default 43

        config CLU_ETH_SPI_MISO_GPIO
            int "W5500 SPI MISO GPIO" if CLU_BOARD_CUSTOM
            range 0 48
            default 44

        config CLU_ETH_SPI_CS_GPIO
            int "W5500 SPI CS GPIO" if CLU_BOARD_CUSTOM
            range 0 48
            default 41

        config CLU_ETH_SPI_INT_GPIO
            int "W5500 interrupt GPIO (-1 = poll every 10 ms)" if CLU_BOARD_CUSTOM
            range -1 48
            default 2

        config CLU_ETH_SPI_RST_GPIO
            int "W5500 reset GPIO (-1 = none)" if CLU_BOARD_CUSTOM
            range -1 48
            default 1

        config CLU_ETH_SPI_CLOCK_MHZ
            int "SPI clock [MHz]"
            range 5 80
            default 20
            help
                Raise the clock only with short traces. Custom board: the defaults of the W5500
                pins are the KinCony F8 ones; pins on GPIO43/44 (the ESP32-S3 UART0 console)
                need the console moved to USB-Serial-JTAG (Component config > ESP System
                Settings > Channel for console output).

    endif

    if CLU_ETH_IF_EMAC

        choice CLU_ETH_PHY
            prompt "PHY chip"
            default CLU_ETH_PHY_LAN87XX
            help
                Generic uses only the standard IEEE 802.3 registers (reset, autonegotiation,
                link / speed / duplex). It fits any compliant 10/100 PHY without its own driver,
                e.g. JL1101; no chip ID check, so a wrong PHY address shows up as no link.

            config CLU_ETH_PHY_LAN87XX
                bool "LAN8720A / LAN87xx (Grenton GATE)"
            config CLU_ETH_PHY_GENERIC
                bool "Generic IEEE 802.3 (JL1101 and other PHYs)"
                depends on CLU_BOARD_CUSTOM
        endchoice

        config CLU_ETH_PHY_ADDR
            int "PHY address (-1 = auto-detect)" if CLU_BOARD_CUSTOM
            range -1 31
            default 0
            help
                Strap address of the PHY on the MDIO bus. Grenton GATE: 0.

        config CLU_ETH_MDC_GPIO
            int "SMI MDC GPIO" if CLU_BOARD_CUSTOM
            range 0 33
            default 23

        config CLU_ETH_MDIO_GPIO
            int "SMI MDIO GPIO" if CLU_BOARD_CUSTOM
            range 0 33
            default 18

        config CLU_ETH_PHY_RST_GPIO
            int "PHY reset GPIO (-1 = none)" if CLU_BOARD_CUSTOM
            range -1 33
            default 2
            help
                Pulsed low at start to reset the PHY. Grenton GATE: GPIO2.

        choice CLU_ETH_CLK
            prompt "RMII 50 MHz reference clock"
            default CLU_ETH_CLK_EXT_IN_GPIO0
            help
                RMII data pins are fixed on the ESP32 (TXEN 21, TXD0 19, TXD1 22, CRS_DV 27,
                RXD0 25, RXD1 26). On WROVER modules GPIO16/17 are taken by the PSRAM, so with
                PSRAM only GPIO0 is usable for the clock.

            config CLU_ETH_CLK_EXT_IN_GPIO0
                bool "External oscillator into GPIO0 (Grenton GATE, WT32-ETH01)"
            config CLU_ETH_CLK_OUT_GPIO0
                bool "ESP32 outputs the clock on GPIO0"
                depends on CLU_BOARD_CUSTOM
            config CLU_ETH_CLK_OUT_GPIO16
                bool "ESP32 outputs the clock on GPIO16 (not with WROVER PSRAM)"
                depends on CLU_BOARD_CUSTOM
            config CLU_ETH_CLK_OUT_GPIO17
                bool "ESP32 outputs the clock on GPIO17 (not with WROVER PSRAM)"
                depends on CLU_BOARD_CUSTOM
        endchoice

    endif

endif

config CLU_SERIAL
    string "CLU serial number (decimal, empty = random, stored in NVS)"
    default ""
    help
        Set to the serial of the CLU being emulated (e.g. 221010155) so Object Manager
        treats this device as that CLU. Overrides the NVS value when non-empty.

config CLU_PRIVATE_KEY
    string "CLU private key / PIN (8 chars, empty = random, stored in NVS)"
    default ""
    help
        Private key from the emulated CLU's sticker. Factory UDP key is derived from it.

config CLU_IV
    string "Factory project IV (32 hex chars, empty = random, stored in NVS)"
    default ""
    help
        IV of the factory project cipher (used until OM sends req_set_key).
        Empty: random per device. Changing it resets the keys to factory default.

choice CLU_DEVICE
    prompt "Device type"
    default CLU_DEVICE_ZWAVE_2
    help
        What Object Manager sees (hardware / firmware type and version in CONFIG.TXT,
        CONFIG.JSON and the diagnostic pack); OM picks the device interface from it.

    config CLU_DEVICE_GATE_HTTP
        bool "GATE HTTP"
        help
            CLU_GATE_HTTP: hwType 0x12, hwVer 2, fwType 3, fwApiVer 0x578, firmware 1.4.2-2346.
            No TF-Bus (the RS485 bus is off). Objects: HttpRequest (121), HttpListener (120),
            Timer. OM declares it as GATE:new(5000, ip, netmask, gateway, "", "").
            See docs/GATE_HTTP.md.

    config CLU_DEVICE_ZWAVE_2
        bool "CLU_ZWAVE_2"
        help
            hwType 0x13, hwVer 1, fwType 3, fwApiVer 0x203, firmware 5.15.24-2635. TF-Bus
            modules on RS485, the CLU virtual objects (Timer, Calendar, Scheduler, ...).
endchoice

menu "RS485 bus (TF-Bus / MySensors)"

    choice CLU_BUS
        prompt "Protocol"
        default CLU_BUS_NONE if CLU_DEVICE_GATE_HTTP
        default CLU_TFBUS
        help
            What the CLU drives on its RS485 / UART pins. "None" leaves the UART and the RS485
            pins alone (e.g. a board without a transceiver). A GATE has no bus:
            only "None" is offered there.

        config CLU_TFBUS
            bool "TF-Bus master (Grenton RS485 modules)"
            depends on !CLU_DEVICE_GATE_HTTP
            help
                Drive Grenton TF-Bus modules over RS485: discovery, addressing, polling and the
                module drivers.

        config CLU_MYSENSORS
            bool "MySensors gateway (RS485 network, MY_RS485)"
            depends on !CLU_DEVICE_GATE_HTTP
            help
                Nodes built with MY_RS485 on the bus; the CLU is node 0, the gateway, and the
                controller: answers find parent / ping / registration / echo, hands out node
                ids (kept in NVS), answers I_CONFIG / I_TIME and value requests, and passes every
                message to the scripts (USER.LUA global MySensors, see docs/MYSENSORS.md). No other
                gateway on the bus. OM sees no real TF-Bus modules.

        config CLU_BUS_NONE
            bool "None (RS485 off)"
            help
                No UART / RS485 driver at all. The CLU runs only virtual objects, scripts, the
                network services and the on-board IO (CLU_LOCAL_IO); without it OM sees no
                modules (discovery / "Clear CLU" report an empty bus).
    endchoice

    config CLU_TFBUS_MASTER
        bool
        default y if CLU_TFBUS || CLU_MYSENSORS || CLU_LOCAL_IO
        help
            TF-Bus master running: on the RS485 wire (CLU_TFBUS) or without a wire, serving only
            modules emulated by the firmware (CLU_MYSENSORS, CLU_LOCAL_IO).

    config CLU_TFBUS_POLL_ROUND_GAP_MS
        int "Idle time after each polling round (ms)"
        depends on CLU_TFBUS_MASTER
        range 0 1000
        default 12
        help
            The master polls all modules back to back, then leaves the bus idle this long before the
            next round. A real CLU idles about 12 ms (2 modules: a round every ~17 ms, 3 modules:
            ~19.4 ms). Commands and driver timers queued meanwhile go out at the start of the next
            round, so they wait at most this long. 0 = poll continuously (one tick between rounds).

    config CLU_TFBUS_POLL_TIMEOUT_MS
        int "STATUS_POLL reply timeout (ms)"
        depends on CLU_TFBUS_MASTER
        range 5 200
        default 20
        help
            How long the master waits for a module's reply to STATUS_POLL. Modules answer within a
            few ms (a SMART PANEL ~0.8 ms after the poll). An unanswered poll holds the bus this
            long, so an absent module still being polled slows every round by this much. 3 missed
            polls take a module offline.

    config CLU_TFBUS_ACK_TIMEOUT_MS
        int "ACK timeout for commands, ADDR_ASSIGN, VERSION_QUERY (ms)"
        depends on CLU_TFBUS_MASTER
        range 5 200
        default 20
        help
            How long the master waits for a module's ACK or reply to everything but STATUS_POLL
            and DISCOVER. Commands are retried 3 times; each rejoin try is one ADDR_ASSIGN, so this
            is also the bus time every rejoin try at an absent module costs.

    config CLU_TFBUS_REJOIN_SLOW_MS
        int "Offline module: one rejoin try every (ms)"
        depends on CLU_TFBUS_MASTER
        range 100 60000
        default 3000
        help
            An offline or unaddressed module is not polled; it gets one ADDR_ASSIGN try this often
            (a real CLU: ~3 s). During the first 60 s after a discovery RESET the tries are every
            40 ms, after a bus fault every CLU_TFBUS_REJOIN_BURST_PACE_MS.

    config CLU_TFBUS_BUS_FAULT_MAX_MS
        int "Bus fault: keep modules online for at most (ms)"
        depends on CLU_TFBUS_MASTER
        range 0 60000
        default 10000
        help
            A polling round in which at least 2 modules on the wire were polled and none answered
            (modules emulated by the firmware, e.g. on-board IO, do not count) is a bus
            fault (e.g. a module rebooting with its transceiver holding the bus), not a fault of
            every module. Missed polls then do not take the modules offline, for at most this
            long; after that they go offline as usual (a real outage, e.g. modules lost power).
            Modules stay listed as online meanwhile, with their last status. 0 = off (every module
            goes offline after 3 missed polls, as on a bus with a single module).

    config CLU_TFBUS_REJOIN_BURST_MS
        int "Fast rejoin after a bus fault: window (ms)"
        depends on CLU_TFBUS_MASTER
        range 0 60000
        default 5000
        help
            After a bus fault ends, offline modules (a module that rebooted lost its address) get
            ADDR_ASSIGN tries every CLU_TFBUS_REJOIN_BURST_PACE_MS for this long, instead of every
            CLU_TFBUS_REJOIN_SLOW_MS. 0 = off.

    config CLU_TFBUS_REJOIN_BURST_PACE_MS
        int "Fast rejoin after a bus fault: one try every (ms)"
        depends on CLU_TFBUS_MASTER
        range 40 3000
        default 100
        help
            Each unanswered ADDR_ASSIGN holds the bus for CLU_TFBUS_ACK_TIMEOUT_MS: with the
            defaults (20 ms, every 100 ms) every module that stays away costs 20% of the bus during
            the window.

    config CLU_TFBUS_LATE_REPLY_GUARD_MS
        int "Late reply guard after a reply timeout (ms)"
        depends on CLU_TFBUS_MASTER
        range 0 20
        default 2
        help
            Module replies carry no sender address. A reply that comes in just after its request
            timed out could otherwise be taken as the reply to the next frame (another module's
            status, or a command's ACK). After every timeout the master keeps reading until the
            line has been quiet this long, and drops what arrived (counted in sys_info
            tfbus_late_replies; many of them: raise CLU_TFBUS_POLL_TIMEOUT_MS). Costs this much
            bus time per unanswered frame. 0 = off.

    config CLU_TFBUS_RESYNC_ON_QUEUE_DROP
        bool "Re-send a module's state when one of its commands is dropped"
        depends on CLU_TFBUS_MASTER
        default y
        help
            A command that finds the command queue full (scripts sending faster than the bus
            takes it) is dropped. With this on, the module's driver init re-sends its whole
            state after its next answered poll, so e.g. a relay switched on does not stay off.

    config CLU_TFBUS_UART_ERROR_STATS
        bool "Count RS485 UART receive errors"
        depends on CLU_TFBUS_MASTER
        default y
        help
            Counts receive buffer overflows, framing errors (noise, wrong baud rate) and break
            conditions (RX held low: A/B shorted or swapped) from the UART driver's event queue;
            reported in sys_info (tfbus_rx_overflows, tfbus_rx_frame_errors, tfbus_rx_breaks).

    if CLU_TFBUS || CLU_MYSENSORS

        config CLU_RS485_UART
            int "UART number" if CLU_BOARD_CUSTOM
            range 1 2
            default 1
            help
                Grenton GATE (ESP32): UART1 on TX=4, RX=3, DE=5.

        config CLU_RS485_TX_GPIO
            int "TX (DI) GPIO" if CLU_BOARD_CUSTOM
            default 4 if IDF_TARGET_ESP32
            default 17

        config CLU_RS485_RX_GPIO
            int "RX (RO) GPIO" if CLU_BOARD_CUSTOM
            default 3 if IDF_TARGET_ESP32
            default 18

        config CLU_RS485_DE_GPIO
            int "DE/RE GPIO (-1 = auto-direction transceiver)" if CLU_BOARD_CUSTOM
            default 5 if IDF_TARGET_ESP32
            default 21
            help
                Waveshare ESP32-S3-RS485-CAN: TX=17, RX=18, DE=21 (driven as UART RTS).

        # One option per protocol: a single one keeps its saved value when the protocol changes.
        config CLU_TFBUS_BAUD
            int "Baud rate"
            depends on CLU_TFBUS
            default 115200
            help
                TF-Bus: 115200.

        config CLU_MYSENSORS_BAUD
            int "Baud rate"
            depends on CLU_MYSENSORS
            default 57600
            help
                The nodes' MY_RS485_BAUD_RATE (57600 here; the MySensors library defaults to 9600).

    endif

    menu "MySensors gateway"
        depends on CLU_MYSENSORS


        config CLU_MYSENSORS_METRIC
            bool "Metric units (I_CONFIG answers M, else I)"
            default y

        config CLU_MYSENSORS_TRACE
            bool "Log every message at INFO"
            default n
            help
                Both directions as text lines ("< " from a node, "> " to a node). Can also be
                switched at runtime from a script: MySensors.trace(true). The bus state (valid
                frames / garbage) is logged on every change regardless.

        config CLU_MYSENSORS_MODULES_MAX
            int "Max emulated IO_MODULE_DIN_8 modules (0 = none)"
            range 0 8
            default 4
            help
                MySensors binary sensors and outputs as TF-Bus modules in Object Manager: each
                module has 8 DIN (S_DOOR, S_MOTION, S_SMOKE, S_WATER_LEAK, S_SOUND, S_VIBRATION,
                S_MOISTURE -> V_TRIPPED) and 8 DOUT (S_BINARY, S_SPRINKLER -> V_STATUS, S_LOCK ->
                V_LOCK_STATUS). Modules are created on demand: a sensor takes the first free channel
                when it presents itself, and a new module (fresh serial) is added when all are
                full, up to this limit. Serials and channels are kept in NVS. Run discovery in OM
                after new sensors appeared and add the modules to the project.
                MySensors.slots() lists which sensor is on which channel.

    endmenu

endmenu

menuconfig CLU_LOCAL_IO
    bool "On-board IO as a TF-Bus module (PCF8575)" if CLU_BOARD_CUSTOM
    depends on !CLU_DEVICE_GATE_HTTP
    default n
    help
        8 relay outputs and 8 digital inputs on one PCF8575 I2C expander on the controller
        board (KinCony F8, KC868-A8v3) appear to Object Manager as an IO_MODULE_DIN_8 module
        (8 DOUT + 8 DIN). The firmware answers the TF-Bus frames for it itself, so it takes
        part in discovery, addressing and polling like a module on the RS485 bus. Add it to
        the project in OM like any discovered module. Works with any RS485 protocol, also
        without RS485 at all (None): the TF-Bus master then serves only the emulated modules.

if CLU_LOCAL_IO

    config CLU_LOCAL_IO_SDA_GPIO
        int "I2C SDA GPIO" if CLU_BOARD_CUSTOM
        range 0 48
        default 8

    config CLU_LOCAL_IO_SCL_GPIO
        int "I2C SCL GPIO" if CLU_BOARD_CUSTOM
        range 0 48
        default 18
        help
            Shared with the RTC (CLU_RTC) when it uses the same pins (KinCony F8 / A8v3).

    config CLU_LOCAL_IO_ADDR
        hex "PCF8575 I2C address" if CLU_BOARD_CUSTOM
        range 0x20 0x27
        default 0x24
        help
            KinCony F8: 0x24, KC868-A8v3: 0x22.

    choice CLU_LOCAL_IO_OUT_PINS
        prompt "Relay outputs on"
        default CLU_LOCAL_IO_OUT_P0 if CLU_BOARD_KINCONY_A8V3
        default CLU_LOCAL_IO_OUT_P1

        config CLU_LOCAL_IO_OUT_P1
            bool "P10-P17, inputs on P00-P07 (KinCony F8)"
            depends on !CLU_BOARD_KINCONY_A8V3
        config CLU_LOCAL_IO_OUT_P0
            bool "P00-P07, inputs on P10-P17 (KC868-A8v3)"
            depends on !CLU_BOARD_KINCONY_F8
    endchoice

    config CLU_LOCAL_IO_OUT_ACTIVE_LOW
        bool "Outputs are active low" if CLU_BOARD_CUSTOM
        default y
        help
            A relay is on when its PCF8575 pin is driven low. The expander powers up with all
            pins high, so the relays stay off until the CLU switches them.

    config CLU_LOCAL_IO_IN_ACTIVE_LOW
        bool "Inputs are active low" if CLU_BOARD_CUSTOM
        default y
        help
            An input reads low when it is active (optocoupler conducting).

    config CLU_LOCAL_IO_SN
        string "Module serial (decimal, empty = random, stored in NVS)"
        default ""
        help
            Like the CLU serial: a random serial is generated once and kept in NVS, so the
            module keeps its identity in the OM project across reboots and updates. Set it to
            take over the serial of a module already in the project. Overrides the NVS value
            when non-empty.

    config CLU_LOCAL_IO_GPIO_INPUTS
        string "GPIO inputs as a second module (comma-separated, up to 8)" if CLU_BOARD_CUSTOM
        default "48,47,21,15,14" if CLU_BOARD_KINCONY_F8
        default ""
        help
            ESP32 pins read as the DIN channels of a second IO_MODULE_DIN_8 module (first pin
            = DIN1). Internal pull-up on; an input is active when pulled low (contact to
            GND). The second module's DOUT channels drive nothing. Empty = no second module.
            KinCony F8: the four 1-Wire terminals (GPIO48, 47, 21, 15, pull-up on the board)
            and the free GPIO14 terminal; a terminal set to 1-Wire bus (CLU_LOCAL_IO_F8_DINx_MODE)
            keeps its channel, always inactive.

    config CLU_LOCAL_IO_SN2
        string "GPIO input module serial (decimal, empty = random, stored in NVS)"
        depends on CLU_LOCAL_IO_GPIO_INPUTS != ""
        default ""
        help
            Like CLU_LOCAL_IO_SN, for the module with the GPIO inputs.

    config CLU_LOCAL_IO_ANALOG_INPUTS
        string "Analog inputs as AnalogIN of an ANALOG_DIN module (GPIO:factor, comma-separated)"
        default "5:1.51,7:1.51,6:6.667,4:6.667" if CLU_BOARD_KINCONY_F8
        default ""
        help
            ESP32 ADC1 pins read as AnalogIN1.. of an emulated ANALOG_DIN module (up to 7; the
            module's 4 AnalogOUT drive nothing). Each pin's voltage [V] times its factor is the
            AnalogIN RawValue: with the input divider / sense resistor of the board in the
            factor, the value at the terminal. Factor 1 if left out ("5,7"). Empty = none.
            KinCony F8: A1 GPIO5 and A2 GPIO7 (0-5 V, factor 1.51 -> volts), A3 GPIO6 and A4
            GPIO4 (4-20 mA over 150 ohm, factor 6.667 -> milliamps). Readings are approximate
            (12 dB attenuation, factory calibration); A1/A2 saturate at about 4.7 V.

    choice CLU_LOCAL_IO_F8_DIN1_MODE
        prompt "Terminal GPIO48 (DIN1): digital input or 1-Wire bus"
        depends on CLU_BOARD_KINCONY_F8
        default CLU_LOCAL_IO_F8_DIN1_INPUT
        help
            The 1-wire terminal GPIO48 (pull-up on the board) is DIN1 of the GPIO input
            module, or a 1-Wire bus for DS18B20 / DS18S20 temperature sensors (VCC, GND, DATA;
            several sensors may share it). As a 1-Wire bus, DIN1 stays in the module but
            always reads inactive. Several terminals may be 1-Wire buses.

        config CLU_LOCAL_IO_F8_DIN1_INPUT
            bool "Digital input DIN1"
        config CLU_LOCAL_IO_F8_DIN1_ONEWIRE
            bool "1-Wire bus (DS18B20 / DS18S20 sensors)"
    endchoice

    choice CLU_LOCAL_IO_F8_DIN2_MODE
        prompt "Terminal GPIO47 (DIN2): digital input or 1-Wire bus"
        depends on CLU_BOARD_KINCONY_F8
        default CLU_LOCAL_IO_F8_DIN2_INPUT
        help
            The 1-wire terminal GPIO47 (pull-up on the board) is DIN2 of the GPIO input
            module, or a 1-Wire bus for DS18B20 / DS18S20 temperature sensors (VCC, GND, DATA;
            several sensors may share it). As a 1-Wire bus, DIN2 stays in the module but
            always reads inactive. Several terminals may be 1-Wire buses.

        config CLU_LOCAL_IO_F8_DIN2_INPUT
            bool "Digital input DIN2"
        config CLU_LOCAL_IO_F8_DIN2_ONEWIRE
            bool "1-Wire bus (DS18B20 / DS18S20 sensors)"
    endchoice

    choice CLU_LOCAL_IO_F8_DIN3_MODE
        prompt "Terminal GPIO21 (DIN3): digital input or 1-Wire bus"
        depends on CLU_BOARD_KINCONY_F8
        default CLU_LOCAL_IO_F8_DIN3_INPUT
        help
            The 1-wire terminal GPIO21 (pull-up on the board) is DIN3 of the GPIO input
            module, or a 1-Wire bus for DS18B20 / DS18S20 temperature sensors (VCC, GND, DATA;
            several sensors may share it). As a 1-Wire bus, DIN3 stays in the module but
            always reads inactive. Several terminals may be 1-Wire buses.

        config CLU_LOCAL_IO_F8_DIN3_INPUT
            bool "Digital input DIN3"
        config CLU_LOCAL_IO_F8_DIN3_ONEWIRE
            bool "1-Wire bus (DS18B20 / DS18S20 sensors)"
    endchoice

    choice CLU_LOCAL_IO_F8_DIN4_MODE
        prompt "Terminal GPIO15 (DIN4): digital input or 1-Wire bus"
        depends on CLU_BOARD_KINCONY_F8
        default CLU_LOCAL_IO_F8_DIN4_INPUT
        help
            The 1-wire terminal GPIO15 (pull-up on the board) is DIN4 of the GPIO input
            module, or a 1-Wire bus for DS18B20 / DS18S20 temperature sensors (VCC, GND, DATA;
            several sensors may share it). As a 1-Wire bus, DIN4 stays in the module but
            always reads inactive. Several terminals may be 1-Wire buses.

        config CLU_LOCAL_IO_F8_DIN4_INPUT
            bool "Digital input DIN4"
        config CLU_LOCAL_IO_F8_DIN4_ONEWIRE
            bool "1-Wire bus (DS18B20 / DS18S20 sensors)"
    endchoice

    config CLU_LOCAL_IO_ONEWIRE_GPIOS
        string "1-Wire bus GPIOs for DS18B20 / DS18S20 sensors (comma-separated, up to 4)" if !CLU_BOARD_KINCONY_F8
        default ""
        help
            Each pin is a 1-Wire bus; the temperature sensors on them appear as ONE_WIRE modules
            (one per sensor, ONEW_SENSOR object) behind the ONE_WIRE_HUB of the ANALOG_DIN
            module. The buses are searched at startup, on OM "Clear CLU" (refresh) and by
            ONE_WIRE_HUB RefreshSensors; sensors are read every 2 s. External power only (no
            parasite power); an external pull-up (4.7 kohm) is needed, the internal one is too
            weak for long wires. A pin also in CLU_LOCAL_IO_GPIO_INPUTS keeps its DIN channel,
            which then always reads inactive. Empty = no 1-Wire.
            KinCony F8: chosen per terminal (CLU_LOCAL_IO_F8_DINx_MODE) instead.

    config CLU_LOCAL_IO_SN3
        string "ANALOG_DIN module serial (decimal, empty = random, stored in NVS)"
        depends on CLU_LOCAL_IO_ANALOG_INPUTS != "" || CLU_LOCAL_IO_ONEWIRE_GPIOS != "" || \
                   CLU_LOCAL_IO_F8_DIN1_ONEWIRE || CLU_LOCAL_IO_F8_DIN2_ONEWIRE || \
                   CLU_LOCAL_IO_F8_DIN3_ONEWIRE || CLU_LOCAL_IO_F8_DIN4_ONEWIRE
        default ""
        help
            Like CLU_LOCAL_IO_SN, for the analog input / 1-Wire hub module. The 1-Wire sensors'
            module serials come from their ROM codes.

endif

menuconfig CLU_RTC
    bool "Battery-backed RTC (I2C)" if CLU_BOARD_CUSTOM
    default n if IDF_TARGET_ESP32
    default y
    help
        Sets the clock at boot, before the scripts run, so they have the right time without
        the network. Written back on every SNTP sync and SetDateTime. Keeps time through a
        power cut only with a backup cell on the board. A missing chip is logged and ignored.

if CLU_RTC

    choice CLU_RTC_CHIP
        prompt "RTC chip"
        default CLU_RTC_DS3231 if CLU_BOARD_KINCONY_F8 || CLU_BOARD_KINCONY_A8V3
        default CLU_RTC_PCF85063

        config CLU_RTC_PCF85063
            bool "PCF85063 (Waveshare ESP32-S3-RS485-CAN)"
            depends on !CLU_BOARD_KINCONY_F8 && !CLU_BOARD_KINCONY_A8V3
        config CLU_RTC_DS3231
            bool "DS3231 (KinCony F8, KC868-A8v3)"
            depends on !CLU_BOARD_WAVESHARE_S3_RS485_CAN
    endchoice

    config CLU_RTC_SDA_GPIO
        int "RTC I2C SDA GPIO" if CLU_BOARD_CUSTOM
        range 0 48
        default 39
        help
            Waveshare ESP32-S3-RS485-CAN: SDA=39, SCL=38. KinCony F8 / KC868-A8v3: SDA=8,
            SCL=18. The bus can be shared with the on-board IO expander (same pins).

    config CLU_RTC_SCL_GPIO
        int "RTC I2C SCL GPIO" if CLU_BOARD_CUSTOM
        range 0 48
        default 38

endif

menuconfig CLU_DISPLAY
    bool "Status display (SSD1306 OLED, I2C)" if CLU_BOARD_CUSTOM
    default n
    help
        128x64 SSD1306 OLED showing the CLU serial number, the Ethernet / WiFi IP addresses, the
        date and time, the TF-Bus modules online and the uptime, refreshed every second. A missing
        display is logged and ignored.

if CLU_DISPLAY

    config CLU_DISPLAY_SDA_GPIO
        int "Display I2C SDA GPIO" if CLU_BOARD_CUSTOM
        range 0 48
        default 8

    config CLU_DISPLAY_SCL_GPIO
        int "Display I2C SCL GPIO" if CLU_BOARD_CUSTOM
        range 0 48
        default 18
        help
            The bus can be shared with the RTC and the on-board IO expander (same pins, KinCony F8).

    config CLU_DISPLAY_ADDR
        hex "Display I2C address" if CLU_BOARD_CUSTOM
        range 0x3c 0x3d
        default 0x3c

endif

config CLU_SOFT_RESET
    bool "req_reset reloads Lua instead of rebooting"
    default y
    help
        On req_reset (OM after a script upload, "reset" in the CLI) close the Lua VM, forget
        the TFBUS modules and boot MAIN.LUA again in a fresh VM, with WiFi, MQTT and the
        UDP/TFTP servers left running. Falls back to a reboot if the script does not reach
        SYSTEM.Loop in time or the bus does not stop. __clu.sys_restart() always reboots.

config CLU_SETUP_WINDOW_S
    int "Setup window after startup [s] (0 = always open)"
    range 0 86400
    default 0
    help
        Discovery (req_discovery_clu), re-keying (req_set_key, anything under the PIN / temp
        key), req_set_clu_ip and opening TFTP (req_start_ftp, req_diagnostic_refresh) are
        only accepted during this many seconds after the CLU is up following a chip boot
        (power-on, reset button, reboot): counting starts once WiFi first has an IP, so a
        slow WiFi connect does not use it up. Afterwards the CLU does not answer discovery and refuses the others; normal
        operation under the project key (req:, req_reset, req_refresh_modules) is unaffected.
        A TFTP session opened inside the window runs until req_tftp_stop or its idle timeout.
        A discovery answered inside the window keeps it open (no time limit) until the next
        reset: req_reset (soft or hard) or a reboot.
        A soft reset (CLU_SOFT_RESET) does not reopen the window; the setup button does.
        In emergency mode (MAIN.LUA failed, EMERGNCY.LUA running) the window stays open with
        no time limit, until the CLU leaves it.
        0 (default) disables the restriction; set e.g. 60 to enable it.

config CLU_SETUP_BUTTON_GPIO
    int "Setup button GPIO (-1 = none)" if CLU_BOARD_CUSTOM
    range -1 48
    default 34 if IDF_TARGET_ESP32
    default 0
    depends on CLU_SETUP_WINDOW_S != 0
    help
        Active-low button (internal pull-up). Holding it for 100 ms reopens the setup window
        for CLU_SETUP_WINDOW_S seconds. Default GPIO0 = the BOOT button of most ESP32-S3
        boards: press it while the CLU runs (held during reset it enters download mode).
        ESP32 default GPIO34 = the reset button of the Grenton GATE (input-only pin: needs the
        board's external pull-up; GPIO0 is the RMII clock there).

config CLU_DEBUG_EXTRA_MODULES
    string "Debug: fake modules in CONFIG.JSON / config.txt"
    default ""
    help
        Extra tfbusDevices entries appended after the modules found on the bus, for trying how
        Object Manager handles module types the bus does not have (e.g. ANALOG_DIN, ONE_WIRE).
        Space-separated "sn:hwType:fwType:fwApiVer" in hex, like the config.txt lines, e.g.
        "19000001:19:02:02 28000001:ff:28:03". The CLU does not talk to them: their objects in
        OM.LUA have no hardware behind them. Leave empty for normal use.

menu "Lua"

    choice CLU_LUA_VERSION
        prompt "Lua version"
        default CLU_LUA_5_3
        help
            Real CLU firmware embeds Lua 5.3, and OM.LUA / user scripts are written for it.
            Lua 5.5 is faster and leaner, but rejects scripts that use `global` as a name or
            assign to a for-loop variable, and has no bit32 library.

        config CLU_LUA_5_3
            bool "Lua 5.3.6 (same as real CLU)"
        config CLU_LUA_5_5
            bool "Lua 5.5.1 (experimental)"
    endchoice

    config CLU_LUA_32BITS
        bool "Use 32-bit Lua integers and floats"
        default n
        help
            Build Lua with 32-bit integers and single-precision floats instead of 64-bit integers
            and doubles. Serial numbers at or above 2^31 become negative, millis exceeds the
            signed integer range after about 24.9 days, and floats retain only about 7 significant
            digits.

    config CLU_LUA_FLOAT
        bool "Use single-precision Lua numbers"
        depends on !CLU_LUA_32BITS
        default y
        help
            Use 32-bit floats for Lua numbers while keeping 64-bit Lua integers. Floating-point
            values retain about 7 significant digits; serial numbers and other integers remain
            64-bit. This setting is unavailable when CLU_LUA_32BITS is enabled.

    config CLU_LUA_PRECOMPILE
        bool "Precompile embedded Lua libraries to bytecode"
        default n
        help
            Compile the Lua libraries built into the firmware (prelude, objects, mqtt, http,
            mysensors) to stripped bytecode on the build host: about 40% (~50 KB) less flash and
            no parsing at boot. Stripped chunks carry no line numbers or local names, so errors
            raised inside these libraries have no file:line. Turn off when debugging them.
            Needs a host C compiler (cc / gcc / clang). User scripts (a:\*.LUA) are unaffected.

    config CLU_LUA_MEM_LIMIT_KB
        int "Lua heap limit (KB)"
        default 4096
        range 256 7680
        help
            Total memory one Lua state may hold (PSRAM + internal RAM). Allocations above it
            fail with a Lua "not enough memory" error after an emergency GC, instead of starving
            WiFi / lwIP of RAM.

    config CLU_LUA_INTERNAL_RESERVE_KB
        int "Internal RAM kept free for the system (KB)"
        default 64
        range 16 256
        help
            When PSRAM is full, Lua falls back to internal RAM only while at least this much
            internal RAM stays free.

endmenu

menu "Telnet log console"

    config CLU_TELNET
        bool "Stream logs over telnet"
        default y
        help
            Read-only TCP console: `telnet <clu-ip>` or `nc <clu-ip> 23` shows the ESP_LOG
            output (also Lua print / DebugLog) live, preceded by the buffered history.
            Ctrl-C / Ctrl-D closes the session. No authentication: restrict with
            CLU_TELNET_ALLOW. Lines logged before the CLU identity is loaded (the boot line
            with the PIN) are never captured.

    config CLU_TELNET_PORT
        int "TCP port"
        range 1 65535
        default 23
        depends on CLU_TELNET

    config CLU_TELNET_MAX_CLIENTS
        int "Concurrent clients"
        range 1 4
        default 2
        depends on CLU_TELNET

    config CLU_TELNET_HISTORY
        int "History buffer [bytes, internal RAM]"
        range 1024 65536
        default 8192
        depends on CLU_TELNET

    config CLU_TELNET_ALLOW
        string "Allowed peers (empty = any, a.b.c.d or a.b.c.d/nn)"
        default ""
        depends on CLU_TELNET
        help
            Connections from other addresses are closed immediately. An invalid value
            refuses everyone.

endmenu

menu "GATE HTTP objects (HttpRequest / HttpListener)"

    config CLU_HTTP
        bool "HttpRequest (class 121) and HttpListener (class 120)"
        default y if CLU_DEVICE_GATE_HTTP
        default n
        help
            The GATE HTTP objects. HttpRequest sends HTTP / HTTPS requests (HTTPS checked
            against the built-in certificate bundle) one after another; HttpListener answers
            requests on CLU_HTTP_PORT, routed by path to the listener whose Path matches.
            Object Manager offers them only on a GATE (CLU_DEVICE_GATE_HTTP); on a CLU they
            work when declared by hand. No authentication: anyone on the network can call the
            listeners. See docs/GATE_HTTP.md.

    config CLU_HTTP_PORT
        int "HttpListener TCP port"
        range 1 65535
        default 80
        depends on CLU_HTTP
        help
            80 on a real GATE. Must differ from the OTA port (CLU_OTA_PORT).

    config CLU_HTTP_MAX_BODY
        int "Largest request / response body [bytes]"
        range 1024 262144
        default 16384
        depends on CLU_HTTP
        help
            Larger responses to HttpRequest are dropped (no OnResponse); larger requests to
            HttpListener get 413. Bodies are held in RAM (PSRAM when the board has it).

    config CLU_HTTP_LISTENER_TIMEOUT_MS
        int "HttpListener: wait for SendResponse [ms]"
        range 500 60000
        default 10000
        depends on CLU_HTTP
        help
            A request not answered by SendResponse within this time gets 504.

endmenu

menu "OpenGr8on OTA updates"

    config CLU_OTA
        bool "Firmware update over the network (HTTP, password)"
        default y
        help
            POST the application image (release asset opengr8on-clu-<board>-<version>-ota.bin, or the
            build's opengr8on_clu_esp32.bin; not the full image) to
            http://<CLU IP>:<port>/ota with HTTP Basic auth (any user name, the OTA password):
              curl -u ota:PASSWORD --data-binary @opengr8on-clu-gate-v1.0.0-ota.bin http://CLU_IP:8080/ota
            The image is verified (chip, SHA-256, project name) before it becomes the boot
            image; the CLU then restarts. With bootloader rollback on, an image that restarts
            before it gets an IP is replaced by the previous one.
            The server only starts with a password: cfg partition ota_pass (tools/mknvs.py,
            web flasher) over CLU_OTA_PASSWORD. Plain HTTP: the password is sent in clear text.

    config CLU_OTA_PASSWORD
        string "Password (8..64 characters, empty = off unless set in the cfg partition)"
        default ""
        depends on CLU_OTA

    config CLU_OTA_PORT
        int "HTTP port"
        range 1 65535
        default 8080
        depends on CLU_OTA
        help
            http://<CLU IP>:<port>/ also serves an upload page (file + password).

    config CLU_OTA_CORS_ORIGIN
        string "Browser origin allowed to upload (CORS, empty = only the CLU's own page)"
        default "https://psobiech.github.io"
        depends on CLU_OTA
        help
            Lets the hosted web flasher call POST /ota directly. Browsers block HTTPS pages
            from reaching plain-HTTP LAN addresses unless they support local network access
            (Chrome asks for permission); the CLU's own page works everywhere. The password is
            still required.

endmenu

menu "OpenGr8on MQTT / Home Assistant"

    config CLU_MQTT_BROKER_URI
        string "Broker URI (empty = MQTT off)"
        default ""
        help
            mqtt://host:1883, mqtts://host:8883, ws://host/mqtt or wss://...
            The connection is only made while the local CLU feature UseCloud (18) is 1
            (interface default; OM.LUA sets it at boot, CLUxxx:set(18, 0) disconnects).
            CloudConnection (19) reports whether the broker is connected.
            mqtts/wss: the CA is read from a:\MQTT_CA.PEM (upload it with TFTP) when present,
            otherwise the built-in certificate bundle (public CAs) is used.

    config CLU_MQTT_USERNAME
        string "Username (empty = anonymous)"
        default ""

    config CLU_MQTT_PASSWORD
        string "Password"
        default ""

    config CLU_MQTT_CLIENT_ID
        string "Client ID (empty = opengr8on-CLU<serial>)"
        default ""

    config CLU_MQTT_TOPIC_BASE
        string "Topic base"
        default "grenton"
        help
            Topics live under <base>/CLU<serial>/: status (online/offline, retained LWT),
            <object>/state, <object>/set, <object>/position, <object>/position/set, <object>/event.

    config CLU_MQTT_KEEPALIVE
        int "Keepalive [s]"
        range 5 600
        default 30

    config CLU_MQTT_SCAN_MS
        int "State scan interval [ms]"
        range 20 5000
        default 300
        help
            How often object values are compared with the last published state. Changes are
            published retained; unchanged values are never resent. An MQTT command or an event
            of an object with states (e.g. OnValueChange) triggers a scan at once (at most every
            20 ms): this interval only bounds the delay of values that change without an event.

    config CLU_MQTT_HA_DISCOVERY
        bool "Home Assistant MQTT discovery"
        default y
        help
            Publishes retained discovery configs for the objects declared in OM.LUA (outputs,
            inputs, buttons, roller shutters, panel sensors) on connect and whenever Home
            Assistant announces "online" on <prefix>/status. Entities removed from OM.LUA get
            their config cleared. USER.LUA can override: MQTT.expose(obj, kind | opts),
            MQTT.hide(obj).

    config CLU_MQTT_HA_PREFIX
        string "Home Assistant discovery prefix"
        default "homeassistant"
        depends on CLU_MQTT_HA_DISCOVERY

    config CLU_MQTT_DIAGNOSTICS
        bool "Publish CLU / ESP32 internals (diagnostic entities)"
        default y
        help
            Local CLU object: boot time, CLU state, firmware, OnTimeChange events.
            Firmware: free heap / minimum free heap / free PSRAM, Lua memory, WiFi RSSI, IP,
            reset reason, TFBUS modules online / total / missed polls, a "Restart" button
            (<root>/system_restart/set, payload PRESS) and a connectivity sensor per TFBUS
            module. In Home Assistant they show under "Diagnostic".

    config CLU_MQTT_DIAG_INTERVAL
        int "Internals sample interval [s]"
        range 5 3600
        default 30
        depends on CLU_MQTT_DIAGNOSTICS
        help
            Heap, RSSI etc. change all the time: they are sampled (and published when changed)
            at this interval instead of every state scan.

    config CLU_MQTT_LOG
        bool "Publish log output (diagnostic)"
        default n
        help
            Every ESP_LOG line (also Lua print / DebugLog) at or above the runtime log level is
            published to <root>/system/log, one message per line, QoS 0, not retained.
            Lines logged while the broker is not connected wait in a RAM buffer and are sent
            after (re)connecting; when the buffer is full, newer lines are dropped and a
            "(N log lines dropped)" notice follows. Lines logged before MQTT init (early boot)
            and the discovery PIN line are never captured.
            Logs show IPs, object names and errors: anyone who can subscribe on the broker
            reads them, so restrict the topic with broker ACLs.

    config CLU_MQTT_LOG_BUFFER
        int "Log buffer [bytes, internal RAM]"
        range 1024 32768
        default 4096
        depends on CLU_MQTT_LOG

    config CLU_MQTT_OBJECT_API
        bool "Raw object API (get/set any feature, call any method)"
        default n
        help
            Generic access to every object declared in OM.LUA (including the local CLU),
            payloads are JSON values:
              <root>/<OBJ>/feature/<idx>/get  (any payload) -> <root>/<OBJ>/feature/<idx>
              <root>/<OBJ>/feature/<idx>/set  42 | "text" | true | plain text
                                              -> <root>/<OBJ>/feature/<idx> (read back)
              <root>/<OBJ>/execute/<idx>      [] | [arg, ...] | single value
                                              -> <root>/<OBJ>/execute/<idx>/result
            Results: {"ok":true,"value":...} or {"ok":false,"error":"..."}.
            Nothing is ever evaluated as Lua and remote-CLU proxies are refused, but anyone
            who can publish to the broker controls every object: use broker ACLs/credentials.

endmenu

