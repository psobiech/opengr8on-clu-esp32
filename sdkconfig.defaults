# Default target ESP32-S3 (Waveshare ESP32-S3-RS485-CAN). Grenton GATE hardware (ESP32-WROVER-B,
# LAN8720A Ethernet): idf.py -B build-esp32 set-target esp32 build
# Target-specific settings (flash size, partition table, PSRAM mode): sdkconfig.defaults.<target>.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_PARTITION_TABLE_CUSTOM=y

# PSRAM for the Lua heap
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y

# FAT a:\ — long names on: the real CLU has CLOUD-PUBLIC.CRT, CLOUD-PRIVATE.PEM, DIAGNOSTIC_PACK.JSON
CONFIG_FATFS_LFN_HEAP=y

CONFIG_FREERTOS_HZ=1000

# Hardening (cheap, no protocol impact): stack-smashing protector on functions with arrays,
# watchpoint on the end of the current task's stack (overflow -> panic + reboot instead of silent
# corruption), light heap poisoning (detects heap overruns on free).
CONFIG_COMPILER_STACK_CHECK_MODE_NORM=y
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y
CONFIG_HEAP_POISONING_LIGHT=y

# Sockets: UDP/1234, TFTP (+transfer), MQTT, SNTP, DNS, telnet listener + clients
CONFIG_LWIP_MAX_SOCKETS=16
