# Common defaults for every board preset (CMakePresets.json: waveshare, gate, f8, a8v3). The target
# comes from the preset; this line only applies to builds without one.
# Target-specific settings (flash size, partition table, PSRAM mode): sdkconfig.defaults.<target>.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_PARTITION_TABLE_CUSTOM=y

# Use the maximum CPU frequency supported by ESP32 and ESP32-S3 boards.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Keep local builds debuggable; CI appends sdkconfig.defaults.release for release firmware.
CONFIG_COMPILER_OPTIMIZATION_DEBUG=y

# PSRAM for the Lua heap
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y

# FAT a:\ — long names on: the real CLU has CLOUD-PUBLIC.CRT, CLOUD-PRIVATE.PEM, DIAGNOSTIC_PACK.JSON
CONFIG_FATFS_LFN_HEAP=y

CONFIG_FREERTOS_HZ=1000

# Hardening (cheap, no protocol impact): stack-smashing protector on functions with arrays,
# watchpoint on the end of the current task's stack (overflow -> panic + reboot instead of silent
# corruption), light heap poisoning (detects heap overruns on free).
CONFIG_COMPILER_STACK_CHECK_MODE_NORM=y
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y
CONFIG_HEAP_POISONING_LIGHT=y

# Sockets: UDP/1234, TFTP (+transfer), MQTT, SNTP, DNS, telnet listener + clients,
# OTA HTTP server (listener, control socket, 2 clients)
CONFIG_LWIP_MAX_SOCKETS=16

# esp-mqtt sends one queued (enqueued) message per task loop pass and then waits up to this long for
# inbound data: at the default 1000 ms a burst of N state updates took N seconds to reach the broker.
CONFIG_MQTT_USE_CUSTOM_CONFIG=y
CONFIG_MQTT_POLL_READ_TIMEOUT_MS=20

# OTA (components/clu_ota): a new image that restarts before it reaches the network (clu_ota_confirm)
# is rolled back to the previous one by the bootloader.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Image size (measured on esp32s3 -Os: ~160 KB less). The CLU is a WiFi station / Ethernet host
# only: no SoftAP, no WPA2-Enterprise, no IPv6. TLS is client-only (mqtts://, wss://, GATE HTTP
# HttpRequest); the "common" CA bundle covers ~99% of public servers at a third of the size of the
# full one. Diagnostic strings (esp_err_to_name, mbedtls errors, assert file/line) are kept.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
CONFIG_LWIP_IPV6=n
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_ESP_WIFI_ENABLE_SAE_PK=n
CONFIG_ESP_WIFI_SOFTAP_SAE_SUPPORT=n
CONFIG_ESP_WIFI_GMAC_SUPPORT=n
CONFIG_LWIP_DHCPS=n
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y
CONFIG_MBEDTLS_SELF_TEST=n
CONFIG_MBEDTLS_VERSION_C=n
CONFIG_MBEDTLS_SSL_RENEGOTIATION=n
CONFIG_MBEDTLS_SSL_MAX_FRAGMENT_LENGTH=n
CONFIG_MBEDTLS_SSL_ALL_ALERT_MESSAGES=n
CONFIG_MBEDTLS_SSL_CACHE_C=n
CONFIG_MBEDTLS_SERVER_SSL_SESSION_TICKETS=n
CONFIG_MBEDTLS_KEY_EXCHANGE_RSA=n
CONFIG_MBEDTLS_CIPHER_MODE_CFB=n
CONFIG_MBEDTLS_CIPHER_MODE_OFB=n
CONFIG_MBEDTLS_CIPHER_MODE_XTS=n
CONFIG_MBEDTLS_CMAC_C=n
CONFIG_MBEDTLS_PEM_WRITE_C=n
CONFIG_MBEDTLS_X509_CRL_PARSE_C=n
CONFIG_MBEDTLS_X509_CSR_PARSE_C=n
CONFIG_MBEDTLS_PKCS7_C=n
CONFIG_MBEDTLS_ECP_DP_SECP521R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP256K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP256R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP384R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP512R1_ENABLED=n
