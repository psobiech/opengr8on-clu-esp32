# KinCony KC868-A8v3: ESP32-S3-WROOM-1U N16R8 (16 MB flash, 8 MB octal PSRAM), W5500 Ethernet,
# RS485, 8 relays + 8 inputs on one PCF8575 (I2C SDA 8 / SCL 18, 0x22). Applied on top of
# sdkconfig.defaults (+ sdkconfig.defaults.esp32s3) by the "a8v3" preset (CMakePresets.json):
#   export IDF_PRESET=a8v3; idf.py build flash monitor

# W5500 INT / RST use GPIO43/44 (UART0 TX/RX): console on the native USB (USB-C) instead.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Ethernet: W5500, WiFi off (can be enabled to run both)
CONFIG_CLU_ETH=y
CONFIG_CLU_ETH_IF_W5500=y
CONFIG_CLU_ETH_SPI_SCLK_GPIO=1
CONFIG_CLU_ETH_SPI_MOSI_GPIO=2
CONFIG_CLU_ETH_SPI_MISO_GPIO=41
CONFIG_CLU_ETH_SPI_CS_GPIO=42
CONFIG_CLU_ETH_SPI_INT_GPIO=43
CONFIG_CLU_ETH_SPI_RST_GPIO=44

# RS485 (TF-Bus): automatic direction, no DE pin
CONFIG_CLU_RS485_UART=1
CONFIG_CLU_RS485_TX_GPIO=39
CONFIG_CLU_RS485_RX_GPIO=38
CONFIG_CLU_RS485_DE_GPIO=-1

# DS3231 RTC on the same I2C bus as the IO expander
CONFIG_CLU_RTC=y
CONFIG_CLU_RTC_DS3231=y
CONFIG_CLU_RTC_SDA_GPIO=8
CONFIG_CLU_RTC_SCL_GPIO=18

# 8 relays (P00-P07) + 8 inputs (P10-P17) as an IO_MODULE_DIN_8
CONFIG_CLU_LOCAL_IO=y
CONFIG_CLU_LOCAL_IO_SDA_GPIO=8
CONFIG_CLU_LOCAL_IO_SCL_GPIO=18
CONFIG_CLU_LOCAL_IO_ADDR=0x22
CONFIG_CLU_LOCAL_IO_OUT_P0=y

# Setup button: GPIO0 (BOOT)
CONFIG_CLU_SETUP_BUTTON_GPIO=0
