# KinCony F8 (docs/devices/kincony-f8.md). Pins, Ethernet, RTC and on-board IO come with the board
# option (menuconfig: Board). Applied on top of sdkconfig.defaults by the "f8" preset
# (CMakePresets.json):
#   export IDF_PRESET=f8; idf.py build flash monitor
CONFIG_CLU_BOARD_KINCONY_F8=y

# W5500 SPI uses GPIO43/44 (UART0 TX/RX): console on the native USB (USB-C) instead. ESP-IDF choice,
# so the board option cannot set it.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
