# KinCony F8: ESP32-S3-WROOM-1U N16R8 (16 MB flash, 8 MB octal PSRAM), W5500 Ethernet, RS485,
# 8 relays + 8 inputs on one PCF8575 (I2C SDA 8 / SCL 18, 0x24). Applied on top of
# sdkconfig.defaults (+ sdkconfig.defaults.esp32s3) by the "f8" preset (CMakePresets.json):
#   export IDF_PRESET=f8; idf.py build flash monitor

# W5500 SPI uses GPIO43/44 (UART0 TX/RX): console on the native USB (USB-C) instead.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Ethernet: W5500 (Kconfig SPI defaults = F8 pins), WiFi off (can be enabled to run both)
CONFIG_CLU_ETH=y
CONFIG_CLU_ETH_IF_W5500=y

# RS485 (TF-Bus): automatic direction, no DE pin
CONFIG_CLU_RS485_UART=1
CONFIG_CLU_RS485_TX_GPIO=16
CONFIG_CLU_RS485_RX_GPIO=17
CONFIG_CLU_RS485_DE_GPIO=-1

# DS3231 RTC on the same I2C bus as the IO expander
CONFIG_CLU_RTC=y
CONFIG_CLU_RTC_DS3231=y
CONFIG_CLU_RTC_SDA_GPIO=8
CONFIG_CLU_RTC_SCL_GPIO=18

# 8 relays (P10-P17) + 8 inputs (P00-P07) as an IO_MODULE_DIN_8
CONFIG_CLU_LOCAL_IO=y
CONFIG_CLU_LOCAL_IO_SDA_GPIO=8
CONFIG_CLU_LOCAL_IO_SCL_GPIO=18
CONFIG_CLU_LOCAL_IO_ADDR=0x24
CONFIG_CLU_LOCAL_IO_OUT_P1=y

# Setup button: GPIO0 (BOOT)
CONFIG_CLU_SETUP_BUTTON_GPIO=0
